<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/photo1"
    android:padding="16dp">



    <TextView
        android:id="@+id/tv_edit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="95dp"
        android:text="修改待办"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_todo_content"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginTop="32dp"
        android:hint="输入待办"
        android:inputType="textCapSentences|textMultiLine"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_edit_title" />

    <EditText
        android:id="@+id/et_todo_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="描述"
        android:textSize="18sp"
        android:textColor="@android:color/darker_gray"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/et_todo_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:id="@+id/tv_deadline"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="选择截止日期"
        android:textSize="12sp"
        android:textColor="@android:color/holo_red_dark"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:background="@drawable/white_border"
        android:layout_marginTop="16dp"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/et_todo_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:id="@+id/tv_remind_time"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="选择提醒时间（可选）"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:background="@drawable/white_border"
        android:layout_marginTop="8dp"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/tv_deadline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_remind_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:background="@drawable/user_info"
            android:text="保存"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_cancel"
            app:layout_constraintTop_toTopOf="parent"/>

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:background="@drawable/btn_transparent_border"
            android:text="取消"
            android:textSize="20sp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/btn_save"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>