<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/log"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/photo2"
    tools:context=".LoginActivity">

    <TextView
        android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:gravity="center"
            android:text="登录界面"
            android:textColor="@color/black"
            android:textSize="52sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    <TextView
            android:id="@+id/username"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="账号："
            android:layout_marginTop="100dp"
            android:textColor="@color/black"
            android:textSize="32sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login"
            app:layout_goneMarginStart="16dp"/>

    <EditText
            android:id="@+id/et_log_username"
            android:layout_width="0dp"
            android:layout_height="49dp"
            android:layout_marginEnd="30dp"
            android:hint="请输入账号"
            android:inputType="textVisiblePassword"
            android:maxLength="12"
            app:layout_constraintStart_toEndOf="@id/username"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/username"
            app:layout_constraintBottom_toBottomOf="@id/username"
            app:layout_goneMarginStart="8dp"
            app:layout_goneMarginEnd="16dp" />

    <TextView
            android:id="@+id/password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="密码："
            android:textColor="@color/black"
            android:textSize="32sp"
            app:layout_constraintStart_toStartOf="@id/username"
            app:layout_constraintTop_toBottomOf="@id/username"/>


        <EditText
            android:id="@+id/et_log_password"
            android:layout_width="0dp"
            android:layout_height="49dp"
            android:hint="请输入密码"
            android:maxLength="16"
            android:inputType="textPassword"
            app:layout_constraintStart_toEndOf="@id/password"
            app:layout_constraintEnd_toEndOf="@id/et_log_username"
            app:layout_constraintTop_toTopOf="@id/password"
            app:layout_constraintBottom_toBottomOf="@id/password"/>


    <CheckBox
        android:id="@+id/remember_pass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/password"
        app:layout_constraintVertical_bias="0.001" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="记住密码"
        android:textSize="26sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/remember_pass"
        app:layout_constraintTop_toBottomOf="@+id/password"
        app:layout_constraintVertical_bias="0.017" />

    <Button
        android:id="@+id/btn_login"
        android:layout_width="360dp"
        android:layout_height="70dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="150dp"
        android:stateListAnimator="@null"
        android:text="登  录"
        android:textSize="30sp"
        android:textColor="@color/black"
        android:background="@drawable/btn_transparent_border"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_log_password"/>

    <Button
        android:id="@+id/btn_register"
        android:layout_width="360dp"
        android:layout_height="70dp"
        android:layout_marginTop="6dp"
        android:layout_gravity="center_horizontal"
        android:stateListAnimator="@null"
        android:text="注  册"
        android:textSize="30sp"
        android:textColor="@color/black"
        android:background="@drawable/btn_transparent_border"
        app:layout_constraintStart_toStartOf="@id/btn_login"
        app:layout_constraintEnd_toEndOf="@id/btn_login"
        app:layout_constraintTop_toBottomOf="@id/btn_login"/>

</androidx.constraintlayout.widget.ConstraintLayout>



